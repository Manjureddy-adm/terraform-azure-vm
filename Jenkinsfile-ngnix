pipeline {
    agent any

    environment {
        PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Build started'
            }
        }

        stage('Test') {
            steps {
                echo 'Tests started'
            }
        }

        stage('Install Nginx') {
            steps {
                sh '''
                    which brew
                    brew --version
                    brew install nginx
                '''
            }
        }

        stage('Start Nginx') {
            steps {
                sh '''
                    brew services start nginx
                '''
            }
        }

        stage('Verify Nginx') {
            steps {
                sh '''
                    nginx -v
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deployment completed'
            }
        }
    }
}
